# Server Configuration
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/skillbridge_ai
DB_CONNECT_TIMEOUT_MS=5000
DB_MAX_POOL_SIZE=10
SHUTDOWN_TIMEOUT_MS=10000

# JWT Authentication Security
# Generate a cryptographically secure 256-bit secret using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum required length: 32 characters. Do not use default or predictable strings.
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_ISSUER=skillbridge-ai
JWT_AUDIENCE=skillbridge-users

# CSRF Protection Security
# Cryptographically dedicated signing key for HMAC-SHA256 double-submit cookie validation.
# In production, this dedicated secret is mandatory and must be at least 32 characters (256 bits).
CSRF_SIGNING_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_CSRF_SIGNING_SECRET_MIN_32_CHARS

# Storage Configuration
# Local directory for private resume PDF uploads (mount persistent volume in production/Docker)
STORAGE_LOCAL_DIR=storage/resumes

# Microservices & Client Integration
AI_SERVICE_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173

# Service-to-Service Authentication
# Must match ai-service's INTERNAL_SERVICE_KEY (minimum 32 characters)
INTERNAL_SERVICE_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_MIN_32_CHARS
