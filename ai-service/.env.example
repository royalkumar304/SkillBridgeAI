PORT=8000
HOST=0.0.0.0
DEBUG=False
ENVIRONMENT=production

# Service-to-Service Authentication
# Generate a cryptographically secure 256-bit key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum required length: 32 characters. Must match backend's INTERNAL_SERVICE_KEY.
INTERNAL_SERVICE_KEY=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_256_BIT_SECRET_MIN_32_CHARS

# CORS Whitelist (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5001

