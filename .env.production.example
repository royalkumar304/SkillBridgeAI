# SkillBridge AI — Production Deployment Environment Variables
# Populate this file on your deployment server before executing docker compose up.

# 1. Backend Secrets (Minimum 32 characters / 256-bit entropy each)
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_strong_64_hex_character_secret_here
CSRF_SIGNING_SECRET=generate_strong_64_hex_character_csrf_secret_here

# 2. Service-to-Service Shared Authentication Key
# Must match between backend and ai-service containers
INTERNAL_SERVICE_KEY=generate_strong_64_hex_character_internal_service_key_here

# 3. Environment & Ports
NODE_ENV=production
CLIENT_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5001/api/v1
